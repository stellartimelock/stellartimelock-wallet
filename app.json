{
  "expo": {
    "name": "Stellar TimeLock",
    "slug": "wallet",
    "version": "1.6.23",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "stellartimelock",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stellartimelock.wallet",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stellartimelock",
      "versionCode": 34,
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#060812"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 320,
          "resizeMode": "contain",
          "backgroundColor": "#060812"
        }
      ],
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-build-properties",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Stellar TimeLock to use the camera to scan pairing QR codes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e23c1997-d6aa-4750-8f36-834af305b121"
      }
    }
  }
}

# Copy this file to .env on the build machine. Do not commit .env.
# Expo inlines every EXPO_PUBLIC_ value into the app binary at bundle time,
# so never put a secret in an EXPO_PUBLIC_ variable.

# Swap goes through the StellarTimeLock swap proxy (proxy/swap-worker.js).
# The SimpleSwap partner keys live only in the proxy as Worker secrets.
# Leave empty to use the default proxy; set it only to use your own.
EXPO_PUBLIC_SWAP_PROXY_URL=

EXPO_PUBLIC_MULTI_ASSET_BETA=1
